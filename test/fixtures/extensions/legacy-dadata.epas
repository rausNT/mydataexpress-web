{@module
Author=DataExpress migration fixture
Version=1.0
Description=Synthetic stateful DaData/OLE compatibility fixture.
@}

const
  FirmParams = '"value", "data.inn", "data.state.status"';
  BankParams = '"data.bic", "data.name.payment"';
  AddressParams = '"data.postal_code", "data.region"';

function GetXMLData(ApiKey, SearchText, SuggestType: string): string;
var
  Client: Variant;
begin
  Client := CreateOleObject('MSXML2.XMLHTTP');
  Client.Open('POST',
    'http://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/' + SuggestType,
    False);
  Client.Send('{"query":"' + SearchText + '"}');
  Result := Client.ResponseText;
end;

{@function
OrigName=DA_FIRM_GET
Name=DA_FIRM_GET
Args=vv
Result=s
@}

function DA_FIRM_GET(ApiKey, SearhStr: Variant): String;
begin
  Result := GetXMLData(ApiKey, SearhStr, 'party');
end;

{@function
OrigName=DA_FIRM_INN
