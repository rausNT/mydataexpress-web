{@module
Author=DataExpress tests
Version=1.0
Description=Portable string helpers
@}

{@function
OrigName=NormalizePhone
Name=NORMALIZE_PHONE
Args=s
Result=s
Group=Text
Description=Normalizes a phone number
@}

function NormalizePhone(Value: String): String;
begin
  Result := Value;
end;

{@function
OrigName=IsPhonePresent
Name=IS_PHONE_PRESENT
Args=s
Result=b
Group=Text
Description=Checks whether a phone number is present
@}

function IsPhonePresent(Value: String): Boolean;
begin
  Result := Value <> '';
end;
