{@action
Id=native-run-001
Target=button
OrigName=RunNativeTool
Name=Run native tool
Group=System
UI=
Description=Runs a native tool
@}

procedure RunNativeTool(FileName: String);
begin
  ShellExecute('open', FileName, '', '', 1);
end;
