{@module
Author=Codex for the DataExpress web modernization project
Version=4.0b1-web1
Description=CAFETERIA-specific web adapter for its kok80-ExportToExcel4.0b1.
The browser downloads SpreadsheetML without Windows OLE.
@}

{@action
Id=07B72A92-28B5-4707-96DA-D3D5AEC0FFE7
@}
procedure KOK80ExportToExcel_form(FormMultiSelect: Integer;
  Fields: TVariantArray2d);
begin
  Session.Debug('kok80 Excel web: form export controls registered');
end;

{@action
Id=F477247A-3094-4D6B-8FD6-C8C91972A3B3
@}
procedure KOK80ExportToExcel(AUseCalc: String;
  AExportToClipboard, AExportToCSV, AAddToMainToolbarButton,
  AAddTodxQueryGridToolbar, AAddTodxFormPopupMenu,
  AAddTodxFormPopupMenuSelected, AAddTodxQueryGridPopupMenu,
  AAddTodxQueryGridPopupMenuSelected, AAddTodxPivotGridPopupMenu: Boolean;
  ACaption: String; AAllFormsMultiSelect, AAllQueriesMultiSelect: Integer;
  ASetTextFormat: Boolean);
begin
  Session.Debug('kok80 Excel web: native browser download adapter enabled');
end;

{@function
Name=ExportToExel
@}
function ExportToExel: Boolean;
begin
  Result := Session.ExportToExcel(Self, '') <> '';
end;
