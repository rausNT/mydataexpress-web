{@action
Id=2973DD3B-75B3-4938-9497-AD0BB341D1DD
OrigName=ShowWaitWindow
Name=Показать окно ожидания
@}
function ShowWaitWindow(const AMsg, AImgName: String;
  W, H: Integer): Variant;
begin
  Self.ActionResult := AMsg;
  Session.Debug('DX_PLUS web: wait message stored for the current request');
  Result := True;
end;

{@action
Id=863C5553-93C2-4C8F-A1E6-1987C6D32920
OrigName=CloseWaitWindow
Name=Скрыть окно ожидания
@}
function CloseWaitWindow(SmoothClosing: Boolean): Variant;
begin
  Self.ActionResult := Null;
  Result := True;
end;

{@action
Id=AFB9DFCF-7996-43A1-A83A-BBCFC5A19928
