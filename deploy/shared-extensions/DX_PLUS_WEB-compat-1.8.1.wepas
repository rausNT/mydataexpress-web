{@module
Author=Codex for the DataExpress web modernization project
Version=1.0
Description=Web compatibility adapters for DX_PLUS 1.8.1 mappings which are
not provided by the upstream DX_PLUS_WEB module.
@}

function CompatRecordId(const Expr: String): Variant;
begin
  Result := 0;
  if Expr = '' then Exit;
  try
    Result := EvalExpr(Expr, Self);
    if Result = Null then Result := 0;
  except
    Result := 0;
  end;
end;

{@action
Id=916E554A-D986-4A5B-A28C-E1303BABE705
OrigName=ListWindowShow
Name=Показать окно списка
@}
function ListWindowShow(const FormName, AFilter, RecIdExpr, ACaption,
  ViewType: String; W, H: Integer; HideTree, ReadOnly: Boolean;
  const ObjName: String; FieldValues: TVariantArray2d): Boolean;
begin
  Self.GotoForm(FormName, CompatRecordId(RecIdExpr), gtoNewTab);
  Result := True;
end;

{@action
Id=E6733302-5018-4F2B-A5B2-7692F0249B39
OrigName=CreatePageWithForm
Name=Создать закладку с формой
@}
procedure CreatePageWithForm(const FormName, ViewType: String;
  SetFmFilter: Boolean; FmFilter: TVariantArray2d;
  const RecIdExpr, TabCaption: String);
begin
  Self.GotoForm(FormName, CompatRecordId(RecIdExpr), gtoNewTab);
end;

