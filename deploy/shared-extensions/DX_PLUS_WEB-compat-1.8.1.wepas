{@action
Id=768EC118-96BD-4D76-A2DA-1C221D8B82ED
OrigName=OpenFolderInExplorer
Name=Открыть папку в проводнике
@}
function OpenFolderInExplorer(const FolderExpr: String;
  AutoCreate: Boolean): Boolean;
begin
  Session.Debug('DX_PLUS web: opening a server folder in the client Explorer is blocked');
  Result := False;
end;

{@action
Id=4437AAE4-C3A2-4F27-8FC7-939AE8FE8429
OrigName=CopyTextToClipboard
Name=Копировать в буфер обмена
@}
function CopyTextToClipboard(const Expr: String): Boolean;
begin
  try
    Self.ActionResult := EvalExpr(Expr, Self);
    Session.Debug('DX_PLUS web: clipboard text is available in ActionResult');
    Result := True;
  except
    Result := False;
  end;
end;

{@action
Id=B053C09F-768D-40A9-ACB9-F9F8B4F1E392
OrigName=SetSortQuery
Name=Установить сортировку запроса
@}
procedure SetSortQuery(const QryName: String; Fields: TVariantArray2d);
begin
  Self.Queries[QryName].Refresh;
  Session.Debug('DX_PLUS web: query refreshed; browser sort metadata is applied by the renderer');
end;

